# Installers ask for settings and generate database secrets. Do not commit your .env.
DC_PROJECT_NAME=drivecraft-local
DC_PLATFORM=linux/arm64
DC_BIND_ADDRESS=127.0.0.1
DC_PORT=8088
DC_COOKIE_SECURE=0
DC_TIMEZONE=America/Mexico_City
DC_IMAGE=drivecraft-local:dev
DC_YTDLP_VERSION=2026.10.26
DC_ADMIN_USER=admin
DC_ADMIN_PASSWORD=CHANGE_ME_choose_a_unique_password
DC_DB_PASSWORD=CHANGE_ME_generate_a_database_password
DC_DB_ROOT_PASSWORD=CHANGE_ME_generate_a_separate_root_password
